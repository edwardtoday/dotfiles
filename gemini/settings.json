{
  "context": {
    "discoveryMaxDirs": 2000
  },
  "general": {
    "previewFeatures": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d",
      "warningAcknowledged": true
    }
  },
  "ide": {
    "hasSeenNudge": true
  },
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "command": "npx",
      "timeout": 60000
    },
    "pencil": {
      "command": "/Applications/Pencil.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
      "args": [
        "--app",
        "desktop",
        "--agent",
        "geminiCLI"
      ],
      "env": {}
    },
    "huashu-chrome": {
      "command": "npx",
      "args": [
        "-y",
        "huashu-chrome",
        "mcp",
        "--client",
        "gemini"
      ]
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "showMemoryUsage": true,
    "theme": "Atom One"
  }
}
