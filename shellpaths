########################################################################
# Shell agnostic path setup
########################################################################

export MANPATH="/usr/local/man:/usr/local/mysql/man:/usr/local/git/man:$MANPATH"

# edwardtoday's Scripts
export PATH=~/.bin:$PATH
export PATH=~/.bin/tsc_tools_for_mac:$PATH

# System
export PATH=/bin:$PATH
export PATH=/sbin:$PATH
export PATH=/usr/bin:$PATH
export PATH=/usr/sbin:$PATH

# TeX
export PATH=/usr/texbin:$PATH

# X11
export PATH=/usr/X11/bin:$PATH

# Ruby
export PATH=/usr/local/opt/ruby/bin:$PATH
export PATH=$PATH:$HOME/.rvm/bin

# Qt
export PATH=$HOME/Qt5.1.1/5.1.1/gcc_64/bin:$PATH

# CCache
export PATH=/usr/lib64/ccache:$PATH

# Android
# 仅在本机存在 SDK 目录时导出，避免旧路径污染 adb / Android 工具链。
if [ -d "$HOME/Library/Android/sdk" ]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  export ANDROID_SDK_ROOT="$ANDROID_HOME"
  export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"
else
  unset ANDROID_HOME
  unset ANDROID_SDK_ROOT
fi

# fastlane
export PATH="$HOME/.fastlane/bin:$PATH"

# Brew
export PATH=/opt/homebrew/bin:$PATH
export PATH=/opt/homebrew/sbin:$PATH
export PATH="/opt/homebrew/opt/imagemagick-full/bin:$PATH"

# Python3
export PATH=~/Library/Python/3.14/bin:$PATH
export PATH=~/Library/Python/3.11/bin:$PATH

# mysql-client
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

# uv
export PATH="$HOME/.local/bin:$PATH"

# Homebrew OpenJDK as default
if [ -d "/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home" ]; then
  export JAVA_HOME="/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home"
  export PATH="$JAVA_HOME/bin:$PATH"
else
  unset JAVA_HOME
fi

eval "$(/opt/homebrew/bin/brew shellenv)"
