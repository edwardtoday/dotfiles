export LANG=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8
export TERM=xterm-256color
export COLORTERM=truecolor

###################
# Editor
###################

# Set textmate as our default command line editor
# export EDITOR="/usr/local/bin/mate -w"
export GIT_EDITOR=vim
export VISUAL=vim
export EDITOR=vim
export ALTERNATE_EDITOR='emacs -nw'

#########################################################################
# Tool paths
#########################################################################

#########################################################################
# Tool settings
#########################################################################
export CLICOLOR=true

export HISTSIZE=1000          # How many lines of history to keep in memory
export SAVEHIST=$HISTSIZE     # Number of history entries to save to disk
export HISTCONTROL=ignoredups # Make some commands not show up in history
export HISTIGNORE="ls:cd:cd -:pwd:exit:reset:clear:date:* --help"
export HISTDUP=erase # Erase duplicates in the history file

# Highlight section titles in manual pages
export LESS_TERMCAP_md=$'\033[38;5;172m'

# Don’t clear the screen after quitting a manual page
export MANPAGER="less -X"

### Homebrew
export HOMEBREW_BOOTSNAP=1
export HOMEBREW_DISPLAY_INSTALL_TIMES=1
export HOMEBREW_NO_AUTO_UPDATE=1

# Clash Verge TUN 在系统层接管流量，默认不要常驻显式 *_proxy 环境变量。

# mysql
export LDFLAGS="-L/opt/homebrew/opt/mysql-client/lib"
export CPPFLAGS="-I/opt/homebrew/opt/mysql-client/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/mysql-client/lib/pkgconfig"

# autoenv 就会默认信任 .env，跳过 authorize 提示
export AUTOENV_ASSUME_YES=1
