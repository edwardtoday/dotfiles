#!/usr/bin/env bash

set -euo pipefail

SKILL_ROOT="${SKILL_ROOT:-${HOME}/.agents/skills/skill-directory-dedup-cleanup}"
TARGET_SCRIPT="${SKILL_ROOT}/scripts/dedup_skill_dirs.py"

usage() {
  cat <<'EOF'
Usage: skills-dedup <scan|preview|apply> [script args...]

Commands:
  scan     Run a read-only duplicate scan.
  preview  Show planned cleanup moves without changing anything.
  apply    Move duplicates from the secondary skill root into the backup directory.

The wrapper forwards to:
  ~/.agents/skills/skill-directory-dedup-cleanup/scripts/dedup_skill_dirs.py
EOF
}

require_target() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required for skills-dedup" >&2
    exit 1
  fi

  if [ ! -f "$TARGET_SCRIPT" ]; then
    echo "Missing target script: $TARGET_SCRIPT" >&2
    echo "Expected the skill to exist under ~/.agents/skills/skill-directory-dedup-cleanup" >&2
    exit 1
  fi
}

main() {
  local command_name="${1:-}"
  if [ $# -gt 0 ]; then
    shift
  fi

  case "$command_name" in
    scan)
      require_target
      exec python3 "$TARGET_SCRIPT" scan "$@"
      ;;
    preview)
      require_target
      exec python3 "$TARGET_SCRIPT" cleanup "$@"
      ;;
    apply)
      require_target
      exec python3 "$TARGET_SCRIPT" cleanup --apply "$@"
      ;;
    ""|help|-h|--help)
      usage
      ;;
    *)
      echo "Unknown command: $command_name" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
