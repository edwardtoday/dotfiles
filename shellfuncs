## remove the "resumable copy" flag of a folder
function clearResumableCopyFlag {
  # 定义局部变量，避免污染外部环境
  local item
  local mod_date
  local xattr_exit_code
  local xattr_found_and_failed_to_remove # 标记属性存在但删除失败

  # 检查是否有参数传入
  if [ $# -eq 0 ]; then
    echo "用法: fixFolder <文件或目录> [其他文件或目录 ...]"
    echo "或者使用 fixFolder * 这样的通配符。"
    return 1 # 返回错误码
  fi

  # 使用 "$@" 来遍历所有传递给函数的参数
  for item in "$@"; do
    # 重置标记
    xattr_found_and_failed_to_remove=0

    # 检查文件或目录是否存在
    if [ ! -e "$item" ]; then
      echo "跳过: 未找到 '$item'"
      continue # 继续处理下一个参数
    fi

    echo "正在处理: $item"

    # 1. 获取原始的修改日期
    #    stat -f "%Sm" 输出的格式类似于 "May 28 10:30:00 2025"
    #    macOS 的 SetFile -d 可以直接识别这种格式
    mod_date=$(stat -f "%Sm" "$item")
    if [ -z "$mod_date" ]; then
      echo "  错误: 无法获取 '$item' 的修改日期。"
      continue
    fi
    echo "  原始修改日期: $mod_date"

    # 2. 删除指定的扩展属性 'com.apple.metadata:kMDItemResumableCopy'
    #    -d: 删除属性
    #    -r: 如果 item 是目录，则递归地从目录及其内容中删除该属性。
    #        这符合你成功案例中 xattr -rc * 的 -r (递归) 行为。
    #        你原始函数中的 -s (处理符号链接本身) 在此场景下通常不是必需的，
    #        因为 resumable copy 标记通常在实际文件/目录上。
    echo "  正在尝试删除扩展属性 'com.apple.metadata:kMDItemResumableCopy'..."
    xattr -dr com.apple.metadata:kMDItemResumableCopy "$item"
    xattr_exit_code=$?

    # 检查 xattr 命令的退出状态码
    if [ $xattr_exit_code -eq 0 ]; then
      echo "  成功: 扩展属性 'com.apple.metadata:kMDItemResumableCopy' 已被删除 (或原本就不存在)。"
    else
      # 如果 xattr -dr 失败，进一步检查属性是否真的存在
      # xattr -p <attr_name> <file> 如果属性存在，则退出码为0；如果不存在，则为1。
      if xattr -p com.apple.metadata:kMDItemResumableCopy "$item" >/dev/null 2>&1; then
        # 属性存在，但删除失败
        echo "  警告: 从 '$item' 删除扩展属性 'com.apple.metadata:kMDItemResumableCopy' 失败 (退出码 $xattr_exit_code)。属性可能仍然存在。"
        xattr_found_and_failed_to_remove=1
      else
        # 属性不存在，xattr -dr 因其他原因失败 (理论上不常见，因为文件存在性已检查)
        # 或者，属性不存在时，xattr -d 也会返回非零退出码（通常是 ENOATTR，值为1）
        echo "  信息: 在 '$item' 上未找到扩展属性 'com.apple.metadata:kMDItemResumableCopy' (xattr -dr 退出码 $xattr_exit_code)。"
      fi
    fi

    # 3. 恢复原始的修改日期
    #    SetFile -d "日期字符串" 文件路径
    #    即使 xattr 删除失败，也尝试恢复日期，因为 xattr 命令本身可能已更改了日期。
    echo "  正在尝试将 '$item' 的修改日期恢复为 '$mod_date'..."
    SetFile -d "$mod_date" "$item"
    if [ $? -eq 0 ]; then
      echo "  成功: '$item' 的修改日期已恢复。"
    else
      echo "  错误: 恢复 '$item' 的修改日期失败。"
    fi
    echo "---" # 分隔每个文件的处理信息
  done
}

# Usage: compresspdf [input file] [output file] [screen|ebook|printer*|prepress]
compresspdf() {
    check_pdf_file() {
        # 检查文件名是否是 PDF 文件
        local filename="$1"
        if [[ "$filename" != *.pdf ]]; then
            echo "Error: '$filename' is not a valid PDF file. File must have a .pdf extension." >&2
            exit 1
        fi
    }

    if [[ $# -eq 1 ]]; then
        # 如果只有一个参数，检查输入文件是否为 PDF
        input="$1"
        check_pdf_file "$input"
        base="${input%.pdf}" # 去掉 .pdf 后缀，作为输出文件的前缀
        gs -sDEVICE=pdfwrite -dNOPAUSE -dQUIET -dBATCH -dPDFSETTINGS=/screen -dCompatibilityLevel=1.4 -sOutputFile="${base}-screen.pdf" "$input"
        gs -sDEVICE=pdfwrite -dNOPAUSE -dQUIET -dBATCH -dPDFSETTINGS=/ebook -dCompatibilityLevel=1.4 -sOutputFile="${base}-ebook.pdf" "$input"
        gs -sDEVICE=pdfwrite -dNOPAUSE -dQUIET -dBATCH -dPDFSETTINGS=/printer -dCompatibilityLevel=1.4 -sOutputFile="${base}-printer.pdf" "$input"
        gs -sDEVICE=pdfwrite -dNOPAUSE -dQUIET -dBATCH -dPDFSETTINGS=/prepress -dCompatibilityLevel=1.4 -sOutputFile="${base}-prepress.pdf" "$input"
    elif [[ $# -eq 2 ]]; then
        # 如果有两个参数，检查输入文件是否为 PDF
        input="$1"
        check_pdf_file "$input"
        if [[ "$2" =~ ^(screen|ebook|printer|prepress)$ ]]; then
            # 第二个参数是 screen/ebook/printer/prepress，用输入文件名生成带后缀的输出文件
            base="${input%.pdf}" # 去掉 .pdf 后缀
            setting="$2"
            gs -sDEVICE=pdfwrite -dNOPAUSE -dQUIET -dBATCH -dPDFSETTINGS=/${setting} -dCompatibilityLevel=1.4 -sOutputFile="${base}-${setting}.pdf" "$input"
        else
            # 第二个参数是输出文件名，检查是否为 PDF 文件
            output="$2"
            check_pdf_file "$output"
            gs -sDEVICE=pdfwrite -dNOPAUSE -dQUIET -dBATCH -dPDFSETTINGS=/printer -dCompatibilityLevel=1.4 -sOutputFile="$output" "$input"
        fi
    elif [[ $# -eq 3 ]]; then
        # 如果有 3 个参数，检查输入和输出文件是否为 PDF
        input="$1"
        output="$2"
        setting="$3"
        check_pdf_file "$input"
        check_pdf_file "$output"
        if [[ "$setting" =~ ^(screen|ebook|printer|prepress)$ ]]; then
            gs -sDEVICE=pdfwrite -dNOPAUSE -dQUIET -dBATCH -dPDFSETTINGS=/${setting} -dCompatibilityLevel=1.4 -sOutputFile="$output" "$input"
        else
            echo "Error: Invalid setting '$setting'. Must be one of: screen, ebook, printer, prepress." >&2
            exit 1
        fi
    else
        # 参数不足时，输出用法提示
        echo "Usage: compresspdf [input file] [output file] [screen|ebook|printer*|prepress]"
        echo "       compresspdf [input file] (generate 4 compressed files with different settings)"
        echo "       compresspdf [input file] [screen|ebook|printer|prepress] (generate one compressed file with suffix)"
        echo "       compresspdf [input file] [output file] (generate compressed file at printer quality)"
    fi
}

# Crop video into 2 by 2 matrix parts
# Usage: video-genmatrix-2x2 [inputvideo]
video-genmatrix-2x2() {
    fullpath=$1
    # echo "fullpath = $fullpath"
    dirname=$(dirname $1)
    # echo "dirname = $dirname"
    basename=$(basename $1)
    # echo "basename = $basename"
    base=${basename%%.*}
    # echo "base = $base"
    ext=${basename#*.}
    # echo "ext = $ext"

    # available encoders: libx264 h264_videotoolbox libx265 hevc_videotoolbox
    ffmpeg -y -i "$1" \
        -tune fastdecode -c:v libx264 -profile baseline -level 41 -vsync 1 -x264opts "keyint=24:min-keyint=24:no-scenecut" -pix_fmt yuv420p -crf 23 -maxrate 10M -refs 1 -movflags +faststart -filter:v "crop=in_w/2:in_h/2:0:0" "$dirname/$base-1-1.mp4" \
        -tune fastdecode -c:v libx264 -profile baseline -level 41 -vsync 1 -x264opts "keyint=24:min-keyint=24:no-scenecut" -pix_fmt yuv420p -crf 23 -maxrate 10M -refs 1 -movflags +faststart -filter:v "crop=in_w/2:in_h/2:in_w/2:0" "$dirname/$base-1-2.mp4" \
