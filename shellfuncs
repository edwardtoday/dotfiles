import os
import sys
import tempfile

dst = sys.argv[1]
key = os.environ.get("CODEX_SELECTED_KEY", "").strip()
if not key:
    raise SystemExit("empty key")

directory = os.path.dirname(dst) or '.'
fd, tmp = tempfile.mkstemp(prefix='.auth.', suffix='.json', dir=directory)
