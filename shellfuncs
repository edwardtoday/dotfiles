function pyclean() {
    find "${@:-.}" -type f \( -name "*.pyc" -o -name "*.pyo" \) -delete
    find "${@:-.}" -type d -name "__pycache__" -exec rm -rf "{}" +
    find "${@:-.}" -depth -type d -name ".mypy_cache" -exec rm -rf "{}" +
    find "${@:-.}" -depth -type d -name ".pytest_cache" -exec rm -rf "{}" +
}

function vrun() {
    local name="${1:-}"
    local candidate

    if [ -z "$name" ]; then
        for candidate in "${PYTHON_VENV_NAME:-venv}" venv .venv; do
            if [ -d "$candidate" ]; then
                name="$candidate"
                break
            fi
        done
    fi

    if [ -z "$name" ] || [ ! -d "$name" ]; then
        echo "Error: no virtual environment found in current directory" >&2
        return 1
    fi

    if [ ! -f "$name/bin/activate" ]; then
        echo "Error: '$name' is not a proper virtual environment" >&2
        return 1
    fi

    . "$name/bin/activate" || return $?
    echo "Activated virtual environment $name"
}

function mkv() {
    local name="${1:-${PYTHON_VENV_NAME:-venv}}"

    python3 -m venv "$name" || return $?
    echo "Created venv in '$name'" >&2
    vrun "$name"
}

