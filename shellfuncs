# Photos 卡住时重启图库守护进程：照片数不增长、缩略图不刷新、iCloud 同步停滞
# （典型日志：cloudphotod "Can't instantiate wrapper for <CPLEngineParameters for
#  SystemLibrary at cloudsync.noindex>" 或 photolibraryd "Unable to reopen connection
#  with com.apple.cloudphotod"）。photolibraryd 不响应 SIGTERM（实测正常运行时也如此），
# 因此等待一段时间后升级为 SIGKILL，再重新打开 Photos 让云端引擎重连，并回读同步状态。
function mac.resetphotosync() {
  local reopen=1
  case "${1:-}" in
    "") ;;
    -n|--no-open) reopen=0 ;;
    -h|--help)
      echo "用法: mac.resetphotosync [--no-open]"
      echo "  重启 photolibraryd/cloudphotod/photoanalysisd，重新打开 Photos 并回读 iCloud 同步状态。"
      echo "  --no-open  重启后不自动打开 Photos"
      return 0 ;;
    *)
      echo "未知参数: $1（用 -h 查看用法）" >&2
      return 2 ;;
  esac

  local daemons=(photolibraryd cloudphotod photoanalysisd)
  local daemon i

  # 1) 先优雅退出 Photos，避免守护进程在写库时被强杀
  if pgrep -qx Photos; then
    echo "→ 退出 Photos"
    osascript -e 'tell application "Photos" to quit' >/dev/null 2>&1
    for ((i = 0; i < 20; i++)); do
      pgrep -qx Photos || break
      sleep 0.5
    done
    if pgrep -qx Photos; then
      echo "  Photos 未响应退出请求，强制结束" >&2
      pkill -x Photos 2>/dev/null
      sleep 2
      pkill -9 -x Photos 2>/dev/null
    fi
  fi

  # 2) 停止守护进程，SIGTERM 无效时升级为 SIGKILL
  for daemon in "${daemons[@]}"; do
    if pgrep -qx "$daemon"; then
      echo "→ 停止 $daemon"
      killall -TERM "$daemon" 2>/dev/null
    fi
  done
  for ((i = 0; i < 10; i++)); do
    if ! pgrep -qx photolibraryd && ! pgrep -qx cloudphotod; then
      break
    fi
    sleep 0.5
  done
  for daemon in "${daemons[@]}"; do
    if pgrep -qx "$daemon"; then
      # photolibraryd 一直忽略 SIGTERM（不是卡死信号），只能强杀
      echo "  $daemon 未退出，改用 SIGKILL"
      killall -KILL "$daemon" 2>/dev/null
    fi
  done
  sleep 1

  # 3) 重新打开 Photos，让 launchd 拉起干净的守护进程并重连 iCloud 引擎
  if [ "$reopen" = 1 ]; then
    echo "→ 重新打开 Photos"
    open -a Photos
  fi

  # 4) 系统图库路径以 group.com.apple.photolibraryd.private 为准
  local lib
  lib=$(plutil -extract SystemLibraryPath raw -o - \
    "$HOME/Library/Containers/com.apple.photolibraryd/Data/Library/Preferences/group.com.apple.photolibraryd.private.plist" 2>/dev/null)

  # 5) 轮询确认云端引擎已打开：cloudphotod 会持有该图库的 CPL store（比翻日志可靠）
  # 注意 i 已在上面 local daemon i 声明过，重复声明会让 zsh 回显它的值
  local engine_ok=0 cplstore
  if [ -n "$lib" ]; then
    cplstore="$lib/resources/cpl/cloudsync.noindex/storage/store.cloudphotodb"
    for ((i = 0; i < 30; i++)); do
      if lsof -c cloudphotod 2>/dev/null | grep -Fq "$cplstore"; then
        engine_ok=1
        break
      fi
      sleep 1
    done
  fi

  # 6) 回读本地资产数
  local count
  if [ -n "$lib" ]; then
    echo "  系统图库: $lib"
    if [ -f "$lib/database/Photos.sqlite" ]; then
      count=$(sqlite3 "file:$lib/database/Photos.sqlite?mode=ro" 'select count(*) from ZASSET;' 2>/dev/null)
      [ -n "$count" ] && echo "  本地资产数: $count（后台会继续从 iCloud 增长）"
    fi
  fi

  if [ "$engine_ok" = 1 ]; then
    echo "✓ iCloud Photos 引擎已重新打开，同步已恢复"
    return 0
  fi

  # 没等到引擎：区分「路径不可访问」和「只是还没开始」
  if log show --last 5m --predicate 'process == "cloudphotod"' --info --style compact 2>/dev/null |
    grep -q "Can't instantiate wrapper for <CPLEngineParameters for SystemLibrary"; then
    echo "✗ SystemLibrary 云端引擎打不开：确认系统图库路径可访问（外部卷是否已挂载）" >&2
    return 1
  fi
  echo "… 未确认引擎已打开；同步可能稍后才开始，可隔几分钟用 mac.resetphotosync 复查资产数"
  return 1
}

function find.name() {
    wild=\'\*$1\*\'
    sh -c "find . -iname $wild"
}

# Simple calculator
function calc() {
    local result=""
    result="$(printf "scale=10;$*\n" | bc --mathlib | tr -d '\\\n')"
    #                       └─ default (when `--mathlib` is used) is 20
    #
    if [[ "$result" == *.* ]]; then
        # improve the output for decimal numbers
        printf "$result" |
            sed -e 's/^\./0./' $( # add "0" for cases like ".5"` \
                -e 's/^-\./-0./'
            ) \
                -e 's/0*$//;s/\.$//' # add "0" for cases like "-.5"`\
        # remove trailing zeros
    else
        printf "$result"
    fi
    printf "\n"
}

# Create a new directory and enter it
function mkd() {
    mkdir -p "$@" && cd "$@"
}

# Create a .tar.gz archive, using `zopfli`, `pigz` or `gzip` for compression
function targz() {
    local tmpFile="${@%/}.tar"
    tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1

    size=$(
        stat -f"%z" "${tmpFile}" 2>/dev/null # OS X `stat`
        stat -c"%s" "${tmpFile}" 2>/dev/null # GNU `stat`
    )

    local cmd=""
    if ((size < 52428800)) && hash zopfli 2>/dev/null; then
        # the .tar file is smaller than 50 MB and Zopfli is available; use it
        cmd="zopfli"
    else
        if hash pigz 2>/dev/null; then
            cmd="pigz"
        else
            cmd="gzip"
        fi
    fi

    echo "Compressing .tar using \`${cmd}\`…"
    "${cmd}" -v "${tmpFile}" || return 1
    [ -f "${tmpFile}" ] && rm "${tmpFile}"
    echo "${tmpFile}.gz created successfully."
}

# Determine size of a file or total size of a directory
function fs() {
    if du -b /dev/null >/dev/null 2>&1; then
        local arg=-sbh
    else
        local arg=-sh
    fi
    if [[ -n "$@" ]]; then
        du $arg -- "$@"
    else
        du $arg .[^.]* *
    fi
}

