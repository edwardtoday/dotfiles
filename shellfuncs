function tds() {
    local dir md5 session_name

    dir=$(basename "$PWD")
    if command -v md5sum >/dev/null 2>&1; then
        md5=$(printf '%s' "$PWD" | md5sum | awk '{print $1}')
    else
        md5=$(printf '%s' "$PWD" | md5 -q)
    fi
    session_name="${dir}-$(printf '%s' "$md5" | cut -c1-6)"
    tmux new -As "$session_name"
}

## update the create date to make it accessible and remove the resumable copy flag
## https://apple.stackexchange.com/a/463951

function fixFolder {
    file=$1
    mod_date=$(stat -f "%Sm" "$file")
    xattr -drs com.apple.metadata:kMDItemResumableCopy $file
    SetFile -d "$mod_date" "$file"
}

mkv2mp4() {
  # 检查 ffmpeg 命令是否存在
  if ! command -v ffmpeg &> /dev/null; then
    echo "错误：未找到 ffmpeg 命令。"
    echo "请先使用 Homebrew 安装：brew install ffmpeg"
    return 1
  fi

  # 检查是否提供了文件参数
  if [ "$#" -eq 0 ]; then
    echo "用法: mkv2mp4 file1.mkv file2.mkv ..."
    echo "或使用通配符: mkv2mp4 *.mkv"
    return 1
  fi

  # 遍历所有传入的参数（文件名）
  for f in "$@"; do
    # 检查文件是否存在
    if [ ! -f "$f" ]; then
        echo "警告：文件 '$f' 不存在，已跳过。"
        continue
    fi

    # 生成输出文件名，即将 .mkv 替换为 .mp4
    output_file="${f%.mkv}.mp4"

    echo "正在转换: '$f' -> '$output_file'"

    # 执行转换命令，-loglevel error 只在发生错误时才显示 ffmpeg 的输出
    ffmpeg -i "$f" -c:v copy -c:a copy -loglevel error "$output_file"

    # 检查 ffmpeg 命令是否成功执行
    if [ $? -eq 0 ]; then
        echo "转换成功: '$output_file'"
    else
        echo "错误：转换 '$f' 失败。"
    fi
  done

  echo "所有任务处理完毕。"
}

